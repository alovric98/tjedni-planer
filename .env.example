# Supabase - vidi README.md za upute kako doći do ovih vrijednosti.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Štiti /api/cron/* rute od poziva izvana - generiraj npr. s
# `openssl rand -hex 32`. Vercel Cron ga automatski šalje kao Bearer token
# kad je postavljen i u Vercel env varijablama.
CRON_SECRET=

# Dev-only prekidač za lokalno testiranje bez stvarnog Google OAuth-a -
# postavi na "true" u .env.local da zaobiđeš login/onboarding redirect.
# NIKAD postaviti u Vercel Production env varijablama.
NEXT_PUBLIC_AUTH_DISABLED=
